{
  "name": "@grounded/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "import-track": "tsx --env-file-if-exists=../../.env src/import/cli.ts",
    "worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node --import tsx src/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.18",
    "@grounded/content": "workspace:^",
    "@grounded/core": "workspace:^",
    "@grounded/crypto": "workspace:^",
    "@grounded/db": "workspace:^",
    "@grounded/providers": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.118",
    "better-auth": "^1.7.6",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
