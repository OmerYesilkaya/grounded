{
  "name": "@grounded/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embedded": "./src/embedded.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "import-track": "tsx --env-file-if-exists=../../.env src/import/cli.ts",
    "stages": "LOG_LEVEL=${LOG_LEVEL:-warn} tsx --env-file-if-exists=../../.env src/dev/stages-cli.ts",
    "worker": "tsx src/dev/worker-dev.ts",
    "start:worker": "node --import tsx src/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.18",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@grounded/content": "workspace:^",
    "@grounded/core": "workspace:^",
    "@grounded/crypto": "workspace:^",
    "@grounded/db": "workspace:^",
    "@grounded/providers": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.118",
    "fflate": "^0.8.3",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.9",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.65"
  }
}
