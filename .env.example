# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://grounded:grounded@localhost:5432/grounded

# Envelope encryption for API keys: "kid:base64" entries (32 random bytes each), comma-separated.
# Generate one with: openssl rand -base64 32
# Keep old kids when rotating; KEY_VAULT_ACTIVE_KID wraps new secrets.
KEY_VAULT_MASTER_KEYS=
KEY_VAULT_ACTIVE_KID=
