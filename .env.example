# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://grounded:grounded@localhost:5432/grounded

# Envelope encryption for API keys: "kid:base64" entries (32 random bytes each), comma-separated.
# Generate one with: openssl rand -base64 32
# Keep old kids when rotating; KEY_VAULT_ACTIVE_KID wraps new secrets.
KEY_VAULT_MASTER_KEYS=
KEY_VAULT_ACTIVE_KID=

# Auth: a random secret of at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Where the web app is served; the API is reached through it at /api.
APP_URL=http://localhost:5173
PORT=8787
# Production only: the host's proxies (comma-separated IPs or CIDR ranges), so sign-in rate limits see
# each client's address. Railway: 100.0.0.0/8.
# TRUSTED_PROXIES=
# Production only: the built web app, served by the API (the Docker image sets it). Vite serves it otherwise.
# WEB_DIST_DIR=
# Offer models the eval harness hasn't passed yet. Development only.
ALLOW_UNGATED_MODELS=true

# Development only: the worker answers with canned responses instead of calling models.
DEMO_MODELS=false

# Learners' files. Without a bucket they go in a folder (default: .files at the repo root), which
# is for development only. Production needs an S3-compatible bucket; on Railway, reference the
# bucket's BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY.
# FILES_DIR=
# FILES_BUCKET=
# FILES_ENDPOINT=
# FILES_REGION=auto
# FILES_ACCESS_KEY_ID=
# FILES_SECRET_ACCESS_KEY=
# Older buckets want path-style URLs (the bucket's Credentials tab on Railway says).
# FILES_FORCE_PATH_STYLE=false

# Magic links by email (Resend). Without a key, links go to the API console.
RESEND_API_KEY=
# Until a domain is verified in Resend, only this sender works, and only to your own address.
EMAIL_FROM=Grounded <onboarding@resend.dev>

# production: magic links are only emailed, and logs are JSON lines; otherwise links are also
# printed in the API terminal, and logs are one readable line each.
NODE_ENV=development

# How much the API and the worker log: trace, debug, info (the default), warn, error or silent.
LOG_LEVEL=info

# true: log what each model call was asked and answered, and why a track edit was rejected. This
# puts learners' words in the log; turn it on to diagnose, then off (docs/design.md §4.2).
LOG_CONTENT=false
