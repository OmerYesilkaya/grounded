# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://grounded:grounded@localhost:5432/grounded

# Envelope encryption for API keys: "kid:base64" entries (32 random bytes each), comma-separated.
# Generate one with: openssl rand -base64 32
# Keep old kids when rotating; KEY_VAULT_ACTIVE_KID wraps new secrets.
KEY_VAULT_MASTER_KEYS=
KEY_VAULT_ACTIVE_KID=

# Auth: a random secret of at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Where the web app is served; the API is reached through it at /api.
APP_URL=http://localhost:5173
PORT=8787
# Offer models the eval harness hasn't passed yet. Development only.
ALLOW_UNGATED_MODELS=true

# Development only: the worker answers with canned responses instead of calling models.
DEMO_MODELS=false

# Magic links by email (Resend). Without a key, links go to the API console.
RESEND_API_KEY=
# Until a domain is verified in Resend, only this sender works, and only to your own address.
EMAIL_FROM=Grounded <onboarding@resend.dev>
